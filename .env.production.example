# Production Environment Variables
# Copy to .env.production and fill in secure values

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# LiteLLM
LITELLM_MASTER_KEY=CHANGE_ME_SECURE_KEY_HERE
LITELLM_DB_PASSWORD=CHANGE_ME_DB_PASSWORD_HERE

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# LLM Provider API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Grafana
GRAFANA_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_HERE

# Build Info
GIT_COMMIT=
BUILD_NUMBER=

# Application URLs
APP_URL=https://yourcompany.com
API_URL=https://api.yourcompany.com
